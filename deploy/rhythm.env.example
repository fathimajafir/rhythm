# /etc/rhythm/rhythm.env — environment for both services.
# cp deploy/rhythm.env.example /etc/rhythm/rhythm.env && edit.
# Owner root:root, mode 600 — this file holds the shared secret.

RHYTHM_STORE_PATH=/var/lib/rhythm/store.json

# Shared secret between the MCP gateways and the API. Empty = disabled (dev only).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RHYTHM_INTERNAL_TOKEN=

# Model routing (Phase 2 — the llm layer reads these when wired):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# RHYTHM_MODEL_SPECS=/etc/rhythm/model-specs.json
# RHYTHM_DEV_SUBJECT=

# Locale defaults (per cohort; the API defaults to en)
# RHYTHM_DEFAULT_LOCALE=en
